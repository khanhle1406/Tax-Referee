{
  "name": "tax-referee",
  "version": "1.1.0",
  "private": true,
  "description": "Trọng tài thuế GTGT đầu vào cho hóa đơn điện tử Việt Nam: quy tắc tất định quyết định, AI chỉ đọc chứng từ, chuyển người đúng lúc bằng một câu hỏi.",
  "license": "MIT",
  "author": "Đội Fprinciples (MLAI Hackathon 2026 · Track VNG)",
  "homepage": "https://limegreen-salamander-517622.hostingersite.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanhle1406/Tax-Referee.git"
  },
  "bugs": {
    "url": "https://github.com/khanhle1406/Tax-Referee/issues"
  },
  "keywords": [
    "vat",
    "e-invoice",
    "vietnam",
    "human-in-the-loop",
    "escalation",
    "audit-log",
    "nextjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "legal:sync": "tsx scripts/ops/sync-legal-updates.ts",
    "test:phase0": "tsx scripts/qa/test-phase0-safety.ts",
    "test:phase1:sprint1": "tsx scripts/qa/test-phase1-sprint1.ts",
    "test:phase1:sprint2": "tsx scripts/qa/test-phase1-sprint2.ts",
    "test:phase1:sprint3": "tsx scripts/qa/test-phase1-sprint3.ts",
    "test:real": "tsx scripts/qa/test-all-cases.ts",
    "dataset:verify": "tsx scripts/qa/verify-invoice-dataset.ts",
    "test:dual-engine": "tsx scripts/qa/test-dual-engine.ts",
    "test:comprehensive": "tsx scripts/qa/test-comprehensive-suites.ts",
    "test:manifest": "tsx scripts/qa/test-regression-manifest.ts",
    "demo:reset": "tsx scripts/ops/reset-demo-data.ts",
    "referee:snapshot": "tsx scripts/qa/referee-snapshot.ts --write",
    "referee:diff": "tsx scripts/qa/referee-snapshot.ts",
    "channels:check": "tsx scripts/ops/channels-check.ts",
    "live:check": "python scripts/ops/check-live.py",
    "test": "tsx scripts/qa/run-all.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:fixtures": "tsx scripts/qa/qa-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test:workflow": "tsx scripts/qa/test-workflow-safety.ts",
    "test:acceptance": "tsx scripts/qa/run-all.ts",
    "test:api": "tsx scripts/qa/test-api-smoke.ts",
    "test:capture": "tsx scripts/qa/test-capture-session.ts",
    "test:receipt-entities": "tsx scripts/qa/test-receipt-entities.ts",
    "test:image-preflight": "tsx scripts/qa/test-image-preflight.ts",
    "test:supplier-inference": "tsx scripts/qa/run-all.ts supplier-inference",
    "test:official-supplier": "tsx scripts/qa/test-official-supplier-lookup.ts && tsx scripts/qa/test-supplier-identity-resolver.ts",
    "evaluate:supplier-samples": "tsx scripts/qa/evaluate-camera-supplier-extraction.ts",
    "evaluate:independent": "tsx scripts/qa/evaluate-independent.ts",
    "evaluate:referee": "tsx scripts/qa/evaluate-referee-development.ts",
    "score:referee-questions": "tsx scripts/qa/score-referee-questions.ts",
    "labels:lock": "tsx scripts/qa/lock-referee-labels.ts",
    "test:referee-core": "tsx scripts/qa/test-referee-core.ts",
    "typecheck:referee": "tsc --noEmit -p tsconfig.referee-qa.json",
    "test:referee-labels": "tsx scripts/qa/test-referee-labeling.ts",
    "test:recovery": "tsx scripts/qa/test-standalone-recovery.ts",
    "test:ai-fallback": "tsx scripts/qa/test-ai-fallback.ts",
    "test:review-regressions": "tsx scripts/qa/run-all.ts review-regressions",
    "test:qa": "tsx scripts/qa/run-all.ts qa-regressions",
    "test:challenge-a": "tsx scripts/qa/run-all.ts challenge-a",
    "test:workspace-ui": "tsx scripts/qa/test-workspace-ui.ts",
    "demo:local": "bash scripts/demo/start-local-demo.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
