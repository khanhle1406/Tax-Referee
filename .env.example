# ==============================================================================
# TAX REFEREE - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Sao chép file này thành .env.local và điền các API key tương ứng:
# cp .env.example .env.local

# 1. TypeSafe AI System One (Jev API)
# Đăng ký và lấy API key tại: https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# 2. Google Gemini API (Mô hình gemini-2.5-flash-lite cho Q-Gen)
# Lấy API key tại: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Cổng port mặc định (Tùy chọn, mặc định 3000 hoặc 3002)
PORT=3002
